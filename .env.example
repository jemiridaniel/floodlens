# Copy to .env and fill in. Never commit .env.

# Meta Model API (SAM 3.1, Muse Spark) — https://dev.meta.ai
MODEL_API_KEY=

# Baseten (Muse Spark Open, portfolio screener) — optional
BASETEN_API_KEY=

# Use the cheaper Contributor-mode model while developing on public data
FLOODLENS_SPARK_MODEL=muse-spark-1.3-contributor

# Reasoning effort for the agent: minimal | low | medium | high | xhigh | max
# ("max" is not available on the Contributor variant). Default medium.
FLOODLENS_REASONING_EFFORT=medium
